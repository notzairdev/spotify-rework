# Spotify API Configuration
# Get your Client ID from: https://developer.spotify.com/dashboard
# Frontend (Next.js) - Public env var
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Backend (Tauri/Rust) - Private env var
SPOTIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: Redirect URI (defaults to http://127.0.0.1:8888/callback)
# NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
